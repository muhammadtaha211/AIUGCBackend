pnpm-lock.yaml
dist/
supabase/migrations/
supabase/.temp/
node_modules/

# Nested Claude Code worktrees. Prettier reads this file only, never .gitignore,
# so without this it walks into a sibling session's checkout and lint goes red
# for reasons that have nothing to do with this tree.
.claude/worktrees/

# Versioned LLM prompts. The bytes ARE the version — prettier would rewrite
# *emphasis* to _emphasis_ and re-pad tables, silently changing what v9 means.
prompts/

# Specs of unattended runs, saved byte for byte as the founder pasted them: the run is checked
# against them, so a reformat would change what was asked for (docs/unattended/protocol.md).
docs/unattended/runs/

# Task prompts, saved byte for byte as the founder pasted them (the plans beside them are
# formatted normally): a reformat would change what was asked for.
docs/claude/prompts/

# Obsidian editor state. Obsidian rewrites these without a final newline every
# time the vault is opened, so formatting them just goes red again.
docs/vault/.obsidian/

# Generated by `pnpm repo-map`. The generator owns every byte, so a reformat here
# would just be undone by the next run and show up as a diff.
docs/repo-map.md
