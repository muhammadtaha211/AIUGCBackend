# apps/admin — exact env keys needed (copy to .env.local and fill in).
# Same Supabase project as apps/web; values are identical to apps/web/.env.local.

# --- Database (Supabase Postgres, direct connection string with service-role privileges) ---
DATABASE_URL=

# --- Supabase Storage (signed URLs for persona reference images) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Auth (browser + middleware; anon/publishable key, RLS applies) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional second lock: HTTP Basic Auth in front of the Supabase gate. ---
# Off when unset. Set both to enable (production recommended).
# ADMIN_BASIC_USER=
# ADMIN_BASIC_PASS=
