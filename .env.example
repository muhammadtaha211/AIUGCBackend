# --- Database (Supabase Postgres, direct connection string with service-role privileges) ---
DATABASE_URL=postgresql://postgres:password@db.PROJECT.supabase.co:5432/postgres

# --- Supabase (Storage + Auth; worker/CLI use the service role key) ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- External AI providers ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Runtime ---
# DRY_RUN=1 stubs every external provider call (no API keys needed). Unset for real calls.
DRY_RUN=1
WORKER_ID=local
