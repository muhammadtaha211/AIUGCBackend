# --- Database (Supabase Postgres, direct connection string with service-role privileges) ---
DATABASE_URL=postgresql://postgres:password@db.PROJECT.supabase.co:5432/postgres

# --- Supabase Storage (service role key; used by worker, CLI, web and admin) ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- apps/web (Next.js reads env from apps/web only — copy the two NEXT_PUBLIC_ lines
#     below, plus DATABASE_URL, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY, into
#     apps/web/.env.local. The web tier does hold the service role key: its route
#     handlers mint signed storage URLs server-side after an ownership check, which is
#     the architecture docs/03-storage.md:56-58 prescribes — the posture and the
#     invariant it rests on are docs/vault/decisions/0045-the-web-tier-holds-the-service-role-key.md) ---

# --- Supabase Auth (browser + middleware; anon/publishable key, RLS applies) ---
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# The anon key — NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (new-style key) also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Product analytics (apps/web only; vault 0103, docs/10-analytics.md) ---
# PostHog's project API key (phc_…), on the web Vercel project and optionally apps/web/.env.local.
# Unset or blank: the SDK is never loaded and nothing is sent. Inlined at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# Leave unset: defaults to the EU cloud (https://eu.i.posthog.com). Any other value turns analytics
# off, except a loopback host for the local hiding check (docs/10-analytics.md).
NEXT_PUBLIC_POSTHOG_HOST=

# --- External AI providers ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
HEYGEN_API_KEY=
# --- Observability ---
SENTRY_DSN=

# --- Social posting (decision 0101, docs/09-social-posting.md) ---
# The Meta app that connects Instagram accounts and publishes Reels. Web needs all three
# (the OAuth and sound routes); the box needs the secret and the key (the publish job).
META_APP_ID=
META_APP_SECRET=
# Only when the app dashboard gives Facebook Login a configuration id instead of a scope list.
META_LOGIN_CONFIG_ID=
# 32 random bytes, base64 — the key platform tokens are sealed under (packages/core/src/secret-box.ts).
SOCIAL_TOKEN_KEY=

# --- Runtime ---
# DRY_RUN=1 stubs every external provider call (no API keys needed). Unset for real calls.
DRY_RUN=1
# Machine identity, burned into jobs.locked_by on every claim — the queue's only
# record of WHICH machine ran a job (both 2026-08 incident investigations pivoted
# on it). local = the founder's desktop; `aiugc work` hardcodes cli:*; the Hetzner
# box sets WORKER_ID=hetzner (docs/07-worker-box.md §7) — never "local" there.
WORKER_ID=local
